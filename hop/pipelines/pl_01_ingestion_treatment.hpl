<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>pl_01_ingestion_treatment</name>
    <name_sync_with_filename>N</name_sync_with_filename>
    <description>Reads the raw air quality dataset, removes empty rows, converts types, handles missing values (-200), applies classification rules and writes the treated and rejected readings to the database.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/16 00:00:00.000</created_date>
    <modified_date>2026/08/16 00:00:00.000</modified_date>
  </info>

  <transform>
    <type>CSVInput</type>
    <name>Read raw readings</name>
    <filename>${PROJECT_HOME}/../data/raw/AirQualityUCI.csv</filename>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>;</separator>
    <enclosure/>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>data_texto</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>hora_texto</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>co_gt_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>pt08_s1_co_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>nmhc_gt_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>c6h6_gt_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>pt08_s2_nmhc_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>nox_gt_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>pt08_s3_nox_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>no2_gt_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>pt08_s4_no2_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>pt08_s5_o3_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>temperatura_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>umidade_relativa_raw</name><length>-1</length><type>Number</type><format>#.##</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>umidade_absoluta_raw</name><length>-1</length><type>Number</type><format>#.####</format><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>coluna_extra_1</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
      <field><name>coluna_extra_2</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency>$</currency><decimal>,</decimal><group>.</group></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>64</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>FilterRows</type>
    <name>Remove empty rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>data_texto</leftvalue>
        <function>IS NOT NULL</function>
        <conditions></conditions>
      </condition>
    </compare>
    <send_true_to>Build date and time text</send_true_to>
    <send_false_to>Discard empty row</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>256</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Dummy</type>
    <name>Discard empty row</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>256</xloc><yloc>176</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Formula</type>
    <name>Build date and time text</name>
    <formulas>
      <formula>
        <field_name>data_hora_texto</field_name>
        <formula>CONCATENATE([data_texto], " ", SUBSTITUTE([hora_texto], ".", ":"))</formula>
        <value_type>2</value_type>
        <value_length>25</value_length>
        <value_precision>-1</value_precision>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>448</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>NullIf</type>
    <name>Handle missing values (-200)</name>
    <fields>
      <field><name>co_gt_raw</name><value>-200</value></field>
      <field><name>pt08_s1_co_raw</name><value>-200</value></field>
      <field><name>nmhc_gt_raw</name><value>-200</value></field>
      <field><name>c6h6_gt_raw</name><value>-200</value></field>
      <field><name>pt08_s2_nmhc_raw</name><value>-200</value></field>
      <field><name>nox_gt_raw</name><value>-200</value></field>
      <field><name>pt08_s3_nox_raw</name><value>-200</value></field>
      <field><name>no2_gt_raw</name><value>-200</value></field>
      <field><name>pt08_s4_no2_raw</name><value>-200</value></field>
      <field><name>pt08_s5_o3_raw</name><value>-200</value></field>
      <field><name>temperatura_raw</name><value>-200</value></field>
      <field><name>umidade_relativa_raw</name><value>-200</value></field>
      <field><name>umidade_absoluta_raw</name><value>-200</value></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>640</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>SelectValues</type>
    <name>Select and rename fields</name>
    <fields>
      <field><name>co_gt_raw</name><rename>co_gt</rename><length>-2</length><precision>-2</precision></field>
      <field><name>pt08_s1_co_raw</name><rename>pt08_s1_co</rename><length>-2</length><precision>-2</precision></field>
      <field><name>nmhc_gt_raw</name><rename>nmhc_gt</rename><length>-2</length><precision>-2</precision></field>
      <field><name>c6h6_gt_raw</name><rename>c6h6_gt</rename><length>-2</length><precision>-2</precision></field>
      <field><name>pt08_s2_nmhc_raw</name><rename>pt08_s2_nmhc</rename><length>-2</length><precision>-2</precision></field>
      <field><name>nox_gt_raw</name><rename>nox_gt</rename><length>-2</length><precision>-2</precision></field>
      <field><name>pt08_s3_nox_raw</name><rename>pt08_s3_nox</rename><length>-2</length><precision>-2</precision></field>
      <field><name>no2_gt_raw</name><rename>no2_gt</rename><length>-2</length><precision>-2</precision></field>
      <field><name>pt08_s4_no2_raw</name><rename>pt08_s4_no2</rename><length>-2</length><precision>-2</precision></field>
      <field><name>pt08_s5_o3_raw</name><rename>pt08_s5_o3</rename><length>-2</length><precision>-2</precision></field>
      <field><name>temperatura_raw</name><rename>temperatura</rename><length>-2</length><precision>-2</precision></field>
      <field><name>umidade_relativa_raw</name><rename>umidade_relativa</rename><length>-2</length><precision>-2</precision></field>
      <field><name>umidade_absoluta_raw</name><rename>umidade_absoluta</rename><length>-2</length><precision>-2</precision></field>
      <field><name>data_hora_texto</name><rename/><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>832</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>SelectValues</type>
    <name>Convert text to date and time</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>data_hora_texto</name>
        <rename>data_hora</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <conversion_mask>dd/MM/yyyy HH:mm:ss</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <lenient_string_to_number>N</lenient_string_to_number>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1024</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Calculator</type>
    <name>Calculate date parts</name>
    <calculation>
      <field_name>ano</field_name>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Integer</value_type>
      <value_length>4</value_length>
      <value_precision>0</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>mes</field_name>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Integer</value_type>
      <value_length>2</value_length>
      <value_precision>0</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>dia</field_name>
      <calc_type>DAY_OF_MONTH</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Integer</value_type>
      <value_length>2</value_length>
      <value_precision>0</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>hora</field_name>
      <calc_type>HOUR_OF_DAY</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Integer</value_type>
      <value_length>2</value_length>
      <value_precision>0</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>dia_semana_num</field_name>
      <calc_type>DAY_OF_WEEK</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Integer</value_type>
      <value_length>1</value_length>
      <value_precision>0</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>data_referencia</field_name>
      <calc_type>REMOVE_TIME_FROM_DATE</calc_type>
      <field_a>data_hora</field_a>
      <value_type>Date</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
    </calculation>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1216</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>ValueMapper</type>
    <name>Set weekday name</name>
    <field_to_use>dia_semana_num</field_to_use>
    <target_field>dia_semana</target_field>
    <non_match_default>INDEFINIDO</non_match_default>
    <target_type>String</target_type>
    <fields>
      <field><source_value>1</source_value><target_value>DOMINGO</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>2</source_value><target_value>SEGUNDA-FEIRA</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>3</source_value><target_value>TERCA-FEIRA</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>4</source_value><target_value>QUARTA-FEIRA</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>5</source_value><target_value>QUINTA-FEIRA</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>6</source_value><target_value>SEXTA-FEIRA</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
      <field><source_value>7</source_value><target_value>SABADO</target_value><empty_string_equals_null>Y</empty_string_equals_null></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1408</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>NumberRange</type>
    <name>Classify time of day</name>
    <inputField>hora</inputField>
    <outputField>turno</outputField>
    <fallBackValue>INDEFINIDO</fallBackValue>
    <rules>
      <rule><lower_bound>-1</lower_bound><upper_bound>5</upper_bound><value>MADRUGADA</value></rule>
      <rule><lower_bound>5</lower_bound><upper_bound>11</upper_bound><value>MANHA</value></rule>
      <rule><lower_bound>11</lower_bound><upper_bound>17</upper_bound><value>TARDE</value></rule>
      <rule><lower_bound>17</lower_bound><upper_bound>24</upper_bound><value>NOITE</value></rule>
    </rules>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1600</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>NumberRange</type>
    <name>Classify CO level</name>
    <inputField>co_gt</inputField>
    <outputField>co_nivel</outputField>
    <fallBackValue>SEM_DADO</fallBackValue>
    <rules>
      <rule><lower_bound/><upper_bound>2</upper_bound><value>BOM</value></rule>
      <rule><lower_bound>2</lower_bound><upper_bound>4.5</upper_bound><value>MODERADO</value></rule>
      <rule><lower_bound>4.5</lower_bound><upper_bound>100</upper_bound><value>CRITICO</value></rule>
    </rules>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1792</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>NumberRange</type>
    <name>Classify NO2 level</name>
    <inputField>no2_gt</inputField>
    <outputField>no2_nivel</outputField>
    <fallBackValue>SEM_DADO</fallBackValue>
    <rules>
      <rule><lower_bound/><upper_bound>80</upper_bound><value>BOM</value></rule>
      <rule><lower_bound>80</lower_bound><upper_bound>180</upper_bound><value>MODERADO</value></rule>
      <rule><lower_bound>180</lower_bound><upper_bound>1000</upper_bound><value>CRITICO</value></rule>
    </rules>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>1984</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Janino</type>
    <name>Calculate quality flags</name>
    <formula>
      <field_name>leitura_valida</field_name>
      <formula_string>(co_gt != null || nox_gt != null || no2_gt != null) ? "S" : "N"</formula_string>
      <value_type>String</value_type>
      <value_length>1</value_length>
      <value_precision>-1</value_precision>
    </formula>
    <formula>
      <field_name>condicao_critica</field_name>
      <formula_string>("CRITICO".equals(co_nivel) || "CRITICO".equals(no2_nivel)) ? "SIM" : "NAO"</formula_string>
      <value_type>String</value_type>
      <value_length>3</value_length>
      <value_precision>-1</value_precision>
    </formula>
    <formula>
      <field_name>motivo_rejeicao</field_name>
      <formula_string>(co_gt == null &amp;&amp; nox_gt == null &amp;&amp; no2_gt == null) ? "Sem leitura de poluentes de referencia (CO, NOx e NO2 ausentes)" : ""</formula_string>
      <value_type>String</value_type>
      <value_length>120</value_length>
      <value_precision>-1</value_precision>
    </formula>
    <java_target_version>11</java_target_version>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>2176</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>FilterRows</type>
    <name>Split valid readings</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>leitura_valida</leftvalue>
        <function>=</function>
        <value>
          <name>constante</name>
          <type>String</type>
          <text>S</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
        <conditions></conditions>
      </condition>
    </compare>
    <send_true_to>Write treated reading</send_true_to>
    <send_false_to>Write rejected reading</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>2368</xloc><yloc>64</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>InsertUpdate</type>
    <name>Write treated reading</name>
    <lookup>
      <key><name>data_hora</name><field>data_hora</field><condition>=</condition></key>
      <value><name>data_hora</name><rename>data_hora</rename><update>N</update></value>
      <value><name>data_referencia</name><rename>data_referencia</rename><update>Y</update></value>
      <value><name>ano</name><rename>ano</rename><update>Y</update></value>
      <value><name>mes</name><rename>mes</rename><update>Y</update></value>
      <value><name>dia</name><rename>dia</rename><update>Y</update></value>
      <value><name>hora</name><rename>hora</rename><update>Y</update></value>
      <value><name>dia_semana</name><rename>dia_semana</rename><update>Y</update></value>
      <value><name>turno</name><rename>turno</rename><update>Y</update></value>
      <value><name>co_gt</name><rename>co_gt</rename><update>Y</update></value>
      <value><name>pt08_s1_co</name><rename>pt08_s1_co</rename><update>Y</update></value>
      <value><name>nmhc_gt</name><rename>nmhc_gt</rename><update>Y</update></value>
      <value><name>c6h6_gt</name><rename>c6h6_gt</rename><update>Y</update></value>
      <value><name>pt08_s2_nmhc</name><rename>pt08_s2_nmhc</rename><update>Y</update></value>
      <value><name>nox_gt</name><rename>nox_gt</rename><update>Y</update></value>
      <value><name>pt08_s3_nox</name><rename>pt08_s3_nox</rename><update>Y</update></value>
      <value><name>no2_gt</name><rename>no2_gt</rename><update>Y</update></value>
      <value><name>pt08_s4_no2</name><rename>pt08_s4_no2</rename><update>Y</update></value>
      <value><name>pt08_s5_o3</name><rename>pt08_s5_o3</rename><update>Y</update></value>
      <value><name>temperatura</name><rename>temperatura</rename><update>Y</update></value>
      <value><name>umidade_relativa</name><rename>umidade_relativa</rename><update>Y</update></value>
      <value><name>umidade_absoluta</name><rename>umidade_absoluta</rename><update>Y</update></value>
      <value><name>co_nivel</name><rename>co_nivel</rename><update>Y</update></value>
      <value><name>no2_nivel</name><rename>no2_nivel</rename><update>Y</update></value>
      <value><name>condicao_critica</name><rename>condicao_critica</rename><update>Y</update></value>
      <schema/>
      <table>leituras_qualidade_ar</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>PostgreSQL_AeroTrack</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>2560</xloc><yloc>16</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>TableOutput</type>
    <name>Write rejected reading</name>
    <connection>PostgreSQL_AeroTrack</connection>
    <schema/>
    <table>leituras_rejeitadas</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
